PORT=5050
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/vyaparsetu

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
# ^ must be 16+ random chars and NOT this placeholder - the server refuses to start otherwise
JWT_EXPIRES_IN=7d

# CORS - frontend origin(s), comma separated
CLIENT_ORIGIN=http://localhost:6060

# File uploads - stored on Cloudinary (nothing touches local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=10

# Optional: AI assistant (get key from aistudio.google.com)
GEMINI_API_KEY=

# Optional: seed script settings (src/seed/seed.js)
# Password assigned to all demo users created by `npm run seed`
SEED_DEMO_PASSWORD=Passw0rd!123
# Folder containing departments.json / approvalTypes.json / demoUsers.json
# (defaults to src/seed/data). Point this elsewhere to seed your own data.
SEED_DATA_DIR=

# Public base URL of this API (encoded in the licence-certificate QR code)
PUBLIC_API_URL=http://localhost:5050
# Renewal opens this many days before expiry (raise it, e.g. 400, to demo renewals on a fresh licence)
RENEWAL_WINDOW_DAYS=90
# Background jobs (licence expiry reminders + SLA breach alerts)
JOBS_INTERVAL_HOURS=6
# Set to true to disable the background jobs
DISABLE_JOBS=false

# --- Real SMS delivery (Twilio). Leave blank to keep OTP/reset codes logged to console only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Real email delivery (any SMTP provider - Gmail, SendGrid, etc). Leave blank for console-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Payment gateway. Currently a real, persisted, instantly-settling "sandbox" ledger
# (see routes/payments.routes.js) - no live bank rails. Set these once you have a real
# Razorpay/PayU/MahaGRAS merchant account, and update settle() to call it.
PAYMENT_PROVIDER=sandbox

# --- DigiLocker (API Setu). Register as a Requester at https://apisetu.gov.in to get these.
# Left blank, the app clearly labels document-pull as Demo Mode instead of pretending to be live.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
